+fn schema_reference_identifies_task_master_format() {
+    let dir = temp_dir("schema");
+    fs::create_dir_all(&dir).expect("temp directory");
+    fs::write(dir.join("tasks.json"), schema_tagged_tasks_json()).expect("fixture");
